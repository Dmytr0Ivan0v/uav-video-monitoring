# Host nginx -> container on 127.0.0.1:8020. Copy to /etc/nginx/sites-available/, link into sites-enabled,
# then `certbot --nginx -d uav.devspace.pp.ua` adds the 443 server and the redirect.
server {
    listen 80;
    server_name uav.devspace.pp.ua;

    location / {
        proxy_pass http://127.0.0.1:8020;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
