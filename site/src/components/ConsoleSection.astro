---
import type { Dict } from '../i18n/en';
import type { ClipDoc } from '../lib/console/types';
import { readPublicJson } from '../lib/data/files';
import { fill } from '../lib/format';
import { factVars } from '../lib/home/facts';
import type { FactsDoc } from '../lib/home/types';
import Console from './console/Console.svelte';
import SectionHead from './SectionHead.astro';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const clip = readPublicJson<ClipDoc>('data/console/clip137.json');
const facts = factVars(readPublicJson<FactsDoc>('data/facts.json'));
---

<section id="console">
  <div class="wrap">
    <SectionHead eyebrow={fill(t.console.eyebrow, { clip: clip.id })} title={t.console.title}>
      <p>{t.console.intro}</p>
    </SectionHead>
    <Console client:visible t={t.console} lang={t.lang} {clip} {facts} />
  </div>
</section>

<style>
  section {
    padding-block: 28px;
  }
</style>
