---
import type { Lang } from '../i18n';
import type { Dict } from '../i18n/en';
import type { ClipDoc } from '../lib/console/types';
import { readPublicJson } from '../lib/data/files';
import { fill } from '../lib/format';
import { factVars } from '../lib/home/facts';
import type { FactsDoc } from '../lib/home/types';
import { PROFILE } from '../profile';

interface Props {
  t: Dict;
  poster: string;
}

const { t, poster } = Astro.props;
const h = t.home.hero;
const vars = factVars(readPublicJson<FactsDoc>('data/facts.json'));
const clip = readPublicJson<ClipDoc>('data/console/clip137.json');
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="wrap grid">
    <div class="intro">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1>{h.title}</h1>
      <p class="lead">{h.lead}</p>
      <div class="cta">
        <a class="btn primary" href="#console">{h.console}</a>
        {
          PROFILE.cv && (
            <button class="btn" type="button" data-hidden={PROFILE.cv[t.lang as Lang]} data-kind="file" data-base={base}>
              {h.cv}
            </button>
          )
        }
        <a class="btn" href="#contact">{h.contact}</a>
      </div>
    </div>
    <figure class="clip" style={`aspect-ratio: ${clip.video_size[0]} / ${clip.video_size[1]}`}>
      <video
        id="hero-video"
        muted
        loop
        playsinline
        preload="none"
        poster={poster}
        data-src={base + clip.media.hero}
        aria-label={h.videoLabel}
        width={clip.video_size[0]}
        height={clip.video_size[1]}></video>
    </figure>
    <dl class="facts">
      {
        t.home.facts.map((f) => (
          <div class="fact">
            <dt class="mono">{fill(f.value, vars)}</dt>
            <dd>{fill(f.text, vars)}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<!-- the clip loads after the page: the first screen is text and the poster -->
<script is:inline>
  addEventListener('load', () => {
    const v = document.getElementById('hero-video');
    if (!v || matchMedia('(prefers-reduced-motion: reduce)').matches || navigator.connection?.saveData) return;
    v.src = v.dataset.src;
    v.play().catch(() => {});
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    grid-template-areas:
      'intro clip'
      'facts facts';
    gap: 28px 40px;
    padding-block: 40px 28px;
    align-items: center;
  }

  .intro {
    grid-area: intro;
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(30px, 4.2vw, 48px);
    font-weight: 700;
    line-height: 1.06;
  }

  .lead {
    max-width: 60ch;
    margin: 16px 0 0;
    color: var(--muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .btn {
    display: inline-flex;
    cursor: pointer;
    font-family: inherit;
    align-items: center;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--fg);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .btn:hover {
    border-color: var(--faint);
  }

  .btn.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .clip {
    grid-area: clip;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel-2);
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .facts {
    grid-area: facts;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 24px;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .fact {
    padding: 14px 0;
  }

  dt {
    font-size: 24px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  dd {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'intro'
        'clip'
        'facts';
    }
  }

  @media (max-width: 560px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .fact {
      border-bottom: 1px solid var(--line);
    }
  }
</style>
