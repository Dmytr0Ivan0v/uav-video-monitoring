---
import type { Lang } from '../i18n';
import type { Dict } from '../i18n/en';
import { PROFILE } from '../profile';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const f = t.home.footer;
---

<footer>
  <div class="wrap">
    <p class="name">{PROFILE.name[t.lang as Lang]}</p>
    <p>{f.data}</p>
    <p>{f.license} <a href={PROFILE.source}>{f.source}</a></p>
  </div>
</footer>

<style>
  footer {
    margin-top: 20px;
    border-top: 1px solid var(--line);
  }

  footer .wrap {
    padding-block: 24px 40px;
  }

  footer p {
    max-width: 90ch;
    margin: 6px 0 0;
    font-size: 12.5px;
    color: var(--faint);
  }

  footer .name {
    font-family: var(--f-display);
    font-size: 15px;
    color: var(--muted);
  }
</style>
