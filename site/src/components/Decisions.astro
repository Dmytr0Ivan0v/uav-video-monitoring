---
import type { Dict } from '../i18n/en';
import { readPublicJson } from '../lib/data/files';
import { fill } from '../lib/format';
import { factVars } from '../lib/home/facts';
import type { FactsDoc } from '../lib/home/types';
import SectionHead from './SectionHead.astro';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const d = t.home.decisions;
const vars = factVars(readPublicJson<FactsDoc>('data/facts.json'));
const parts = ['problem', 'decision', 'result', 'cost'] as const;
---

<section id="decisions">
  <div class="wrap">
    <SectionHead eyebrow={d.eyebrow} title={d.title} />
    <div class="cards">
      {
        d.items.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <dl>
              {parts.map((p) => (
                <div>
                  <dt>{d[p]}</dt>
                  <dd>{fill(item[p], vars)}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    padding-block: 28px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 14px;
  }

  .card {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }

  h3 {
    margin-bottom: 10px;
    font-size: 19px;
  }

  dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  dt {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  dd {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
</style>
