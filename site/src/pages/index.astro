---
import Base from '../layouts/Base.astro';
---

<Base title="UAV video monitoring" description="Detection and tracking for UAV video: stream faults, browser detector, visual odometry.">
  <main class="wrap">
    <p class="eyebrow">uav_monitor</p>
    <h1>UAV video monitoring</h1>
  </main>
</Base>

<style>
  main {
    padding-block: 44px;
  }

  h1 {
    font-size: clamp(32px, 4.6vw, 52px);
    line-height: 1.04;
    font-weight: 700;
  }
</style>
